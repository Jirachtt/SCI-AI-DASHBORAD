rules_version = '2';

// SCI AI Dashboard - Firestore Security Rules
// Security goal:
// - Users can create/read their own profile safely.
// - Users cannot promote themselves by editing role/status/role validity.
// - Admin has the complete read view and manages users; dataset writes remain scoped.
// - Dean/Staff can write operational datasets; everyone signed in can read shared dashboard data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerHasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerHasApprovedRole(roles) {
      return callerHasProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function callerIsDean() {
      return callerHasApprovedRole(['dean']);
    }

    function callerCanManageUsers() {
      return callerHasProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canManageUsers == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemAdmin == true
        );
    }

    function callerCanManageDashboardData() {
      return callerHasApprovedRole(['admin', 'dean', 'chair', 'staff']);
    }

    function callerCanManageDashboardDataset(datasetId) {
      return callerHasApprovedRole(['admin', 'dean', 'staff'])
        || (
          callerHasApprovedRole(['chair'])
          && datasetId in [
            'students',
            'student_stats',
            'tcas_admissions',
            'course_analytics',
            'student_life',
            'graduation'
          ]
        );
    }

    function hasMjuSsoClaim() {
      return isSignedIn()
        && (
          request.auth.token.mjuVerified == true
          || request.auth.token.mjuRole != null
          || request.auth.token.mjuUserType != null
        );
    }

    function publicSignupRoleIsAllowed() {
      return (
        request.resource.data.role in ['general', 'student']
        && request.resource.data.status == 'approved'
      ) || (
        request.resource.data.role in ['pending_staff', 'pending_chair']
        && request.resource.data.status == 'pending'
      );
    }

    function selfUserMutableKeys() {
      return [
        'name',
        'avatar',
        'photoURL',
        'displayName',
        'email',
        'roleLabel',
        'preferences',
        'theme',
        'lastLoginAt',
        'lastSeenAt'
      ];
    }

    function safeSelfUserUpdate(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfUserMutableKeys())
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('roleValidity', null) == resource.data.get('roleValidity', null)
        && request.resource.data.get('roleStartsAt', null) == resource.data.get('roleStartsAt', null)
        && request.resource.data.get('roleExpiresAt', null) == resource.data.get('roleExpiresAt', null);
    }

    function mjuSsoMutableKeys() {
      return [
        'name',
        'avatar',
        'photoURL',
        'displayName',
        'email',
        'role',
        'roleLabel',
        'status',
        'authProvider',
        'mjuVerified',
        'mjuId',
        'studentId',
        'employeeId',
        'department',
        'faculty',
        'mjuDetectedRole',
        'mjuDetectedRoleLabel',
        'mjuClaims',
        'mjuAcademic',
        'mjuActivity',
        'roleStartedAt',
        'roleStartsAt',
        'roleExpiresAt',
        'roleDurationYears',
        'roleManagedAt',
        'roleValidity',
        'lastLoginAt',
        'lastSeenAt'
      ];
    }

    function safeMjuSsoUserUpdate(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && hasMjuSsoClaim()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(mjuSsoMutableKeys())
        && request.resource.data.status == 'approved'
        && request.resource.data.role in ['dean', 'chair', 'staff', 'student', 'general', 'admin'];
    }

    function managedUserMutableKeys() {
      return [
        'role',
        'roleLabel',
        'avatar',
        'status',
        'approvedBy',
        'approvedAt',
        'roleStartedAt',
        'roleExpiresAt',
        'roleDurationYears',
        'roleManagedAt',
        'roleManagedBy',
        'updatedAt'
      ];
    }

    function safeManagedUserUpdate(uid) {
      return callerCanManageUsers()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(managedUserMutableKeys())
        && request.resource.data.role in ['dean', 'chair', 'staff', 'student', 'general', 'admin', 'pending_staff', 'pending_chair'];
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          publicSignupRoleIsAllowed()
          || (
            hasMjuSsoClaim()
            && request.resource.data.role in ['dean', 'chair', 'staff', 'student', 'general', 'admin']
            && request.resource.data.status == 'approved'
          )
        );
      allow update: if safeSelfUserUpdate(uid) || safeMjuSsoUserUpdate(uid) || safeManagedUserUpdate(uid);
      allow delete: if false;
    }

    match /datasets/{datasetId} {
      allow read: if isSignedIn();
      allow write: if callerCanManageDashboardDataset(datasetId);

      match /history/{historyId} {
        allow read: if isSignedIn();
        allow write: if callerCanManageDashboardDataset(datasetId);
      }
    }

    match /ai_chat_history/{sessionId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if callerCanManageDashboardData();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
