ADMIN_LOGIN_NAME=Admin
ADMIN_LOGIN_DEPARTMENT=Faculty of Science
ADMIN_LOGIN_FACULTY=Faculty of Science
GEMINI_API_KEY=
# Application safeguards below are enforced by SCI AI. They are not the
# provider account quota and are shown in UI only when server usage is available.
AI_GLOBAL_RPM_LIMIT=45
AI_GLOBAL_TPM_LIMIT=750000
AI_GLOBAL_RPD_LIMIT=500
# Optional application budget. Leave blank to hide the budget meter; this is
# an SCI AI safeguard, not the provider account quota.
AI_DAILY_TOKEN_BUDGET=
AI_CLIENT_RPM_LIMIT=6
# Optional verified limits/pricing. Leave empty rather than guessing.
# Example: {"gemini-3.5-flash":1048576,"gemini-3.1-flash-lite":1048576}
AI_MODEL_CONTEXT_LIMITS_JSON=
# Future cost readiness only; no price is displayed while this is empty.
AI_MODEL_PRICING_JSON=
CRON_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
